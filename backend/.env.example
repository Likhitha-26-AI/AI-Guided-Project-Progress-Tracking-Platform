# Copy this file to ".env" and fill in your own values. Never commit the real ".env".

# --- Security ---
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_this_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Hugging Face (free inference API) ---
# Get a free token at https://huggingface.co/settings/tokens (read access is enough)
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Any free-tier instruction-tuned model works here. This one is a solid free default.
HUGGINGFACE_MODEL=HuggingFaceH4/zephyr-7b-beta

# --- GitHub OAuth (free) ---
# Create an OAuth app at https://github.com/settings/developers
# Homepage URL: http://localhost:5173
# Callback URL: http://localhost:8000/api/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# --- Database ---
DATABASE_URL=sqlite:///./app.db

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
